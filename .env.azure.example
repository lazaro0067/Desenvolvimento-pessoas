# 🔧 Variáveis de Ambiente para Azure Container Apps
# Este arquivo NÃO será commitado no Git por segurança

# ====== BANCO DE DADOS AZURE SQL ======
# Será criado automaticamente pelo script deploy-azure.ps1
# Formato: Server=tcp:{servidor}.database.windows.net,1433;Initial Catalog={database};Persist Security Info=False;User ID={usuario};Password={senha};MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
CONNECTION_STRING=

# ====== OPENAI / AZURE OPENAI (Opcional) ======
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# ====== STRIPE PAYMENT (Opcional) ======
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# ====== AZURE BLOB STORAGE (Opcional - Videos) ======
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=videos

# ====== CONFIGURAÇÕES DA APLICAÇÃO ======
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# ====== CORS (Se necessário) ======
# CORS_ORIGINS=https://seudominio.com,https://www.seudominio.com
